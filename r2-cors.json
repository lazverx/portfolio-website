{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://laz.is-a.dev",
          "http://localhost:5173",
          "http://localhost:4173"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["Range", "If-None-Match", "If-Modified-Since"]
      },
      "exposeHeaders": ["Content-Length", "Content-Range", "Accept-Ranges", "ETag"],
      "maxAgeSeconds": 86400
    }
  ]
}
