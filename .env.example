# Base URL for Cloudflare R2 public bucket or custom domain (no trailing slash).
# Example:
#   VITE_MEDIA_BASE_URL=https://media.laz.is-a.dev
#   VITE_MEDIA_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
#
# When set during `npm run build` (e.g. in Vercel Environment Variables),
# videos are served directly from Cloudflare R2 Edge CDN and excluded from dist/.
# When omitted, Vite falls back to local faststart MP4s automatically.
VITE_MEDIA_BASE_URL=
